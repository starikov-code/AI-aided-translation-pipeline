k mtype="seg" mid="642">Derbent, 1995.</mrk> </target><sdl:seg-defs><sdl:seg id="639" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">g7tHR2HrTTthcBa284u9arw8OGI=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">g7tHR2HrTTthcBa284u9arw8OGI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:48</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-718824280</sdl:value></sdl:seg><sdl:seg id="640" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">6t+xgUJOiDosEl4LuH2SIwEiOeA=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">6t+xgUJOiDosEl4LuH2SIwEiOeA=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:48</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1458078348</sdl:value></sdl:seg><sdl:seg id="641" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">M9CuRIMHzNWQinlr94KPKb7ypzY=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">M9CuRIMHzNWQinlr94KPKb7ypzY=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:48</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2065117835</sdl:value></sdl:seg><sdl:seg id="642" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">uvduP7196q+0kXIRFA3Vwx6Y4Kc=</sdl:value></sdl:prev-origin><sdl:val