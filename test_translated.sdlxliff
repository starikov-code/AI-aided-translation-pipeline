2026 21:42:07</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-403323191</sdl:value></sdl:seg><sdl:seg id="350" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">Tn9VJRlYWBiWiorfCDPQ9gXJb84=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Tn9VJRlYWBiWiorfCDPQ9gXJb84=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:07</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1346574139</sdl:value></sdl:seg><sdl:seg id="351" conf="Draft" origin="tm" origin-system="Jew_study_RU_EnUK" percent="100"><sdl:rep id="MXAHRxiF+It6HYw3JouPkebr7Fg="/><sdl:value key="SegmentIdentityHash">MXAHRxiF+It6HYw3JouPkebr7Fg=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:07</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1847863591</sdl:value></sdl:seg><sdl:seg id="352" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">E19swHXXbiOvW6btTZAvc8XNYSc=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">E19swHXXbiOvW6btTZAvc8XNYSc=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:07</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2066026457</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="133"/><sdl:cxt id="38"/><sdl:cxt id="39"/><sdl:cxt id="40"/><sdl:node id="76"/></sdl:cxts><trans-unit id="51f84fe1-b910-48ce-8a6a-991