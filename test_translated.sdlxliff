ari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="SDL:OriginalTranslationHash">366507861</sdl:value></sdl:seg><sdl:seg id="355" conf="Draft" origin="tm" origin-system="belle lettre RU_ENuk" percent="100"><sdl:rep id="kvDb2IoakeVV5COiU7UJZ5iVYjA="/><sdl:value key="SegmentIdentityHash">kvDb2IoakeVV5COiU7UJZ5iVYjA=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:07</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1057708863</sdl:value></sdl:seg><sdl:seg id="356" conf="Draft" origin="interactive"><sdl:rep id="VTXUbYARB2KsSnkp1Gy0YXH2hEQ="/><sdl:prev-origin origin="source"><sdl:rep id="VTXUbYARB2KsSnkp1Gy0YXH2hEQ="/><sdl:value key="SegmentIdentityHash">VTXUbYARB2KsSnkp1Gy0YXH2hEQ=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">VTXUbYARB2KsSnkp1Gy0YXH2hEQ=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:07</sdl:value><sdl:value key="SDL:OriginalTranslationHash">127968732</sdl:value></sdl:seg><sdl:seg id="357" conf="Draft" origin="interactive"><sdl:rep id="JOF/cmYdtoKxk5vrBOghIiic6qI="/><sdl:prev-origin origin="source"><sdl:rep id="JOF/cmYdtoKxk5vrBOghIiic6qI="/><sdl:value key="SegmentIdentityHash">JOF/cmYdtoKxk5vrBOghIiic6qI=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">JOF/cmYdtoKxk5vrBOghIiic6qI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:07</sdl:value><sdl:value key="SDL:OriginalTranslationHash">13671