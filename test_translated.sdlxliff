key="SegmentIdentityHash">cWNYssaqmbsCfFGigGDn9T+Y1eI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1227917650</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="267"/><sdl:cxt id="38"/><sdl:cxt id="39"/><sdl:cxt id="40"/><sdl:node id="186"/></sdl:cxts><trans-unit id="f2eb4714-eb62-41f7-be67-e36219508eaf"><source><g id="8764">шöгυрд</g></source><seg-source><g id="8764"><mrk mtype="seg" mid="594">шöгυрд</mrk></g></seg-source><target><g id="8764"><mrk mtype="seg" mid="594">şögυrd</mrk></g></target><sdl:seg-defs><sdl:seg id="594" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">Q8YvtBrY4l7ucEGLk2cRe6h2T2E=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Q8YvtBrY4l7ucEGLk2cRe6h2T2E=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-718625556</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="268"/><sdl:cxt id="38"/><sdl:cxt id="39"/><sdl:cxt id="40"/><sdl:node id="187"/></sdl:cxts><trans-unit id="81ab18c2-94b5-4301-99df-beb6b20d14ae"><source>перс. <g id="8770">şagerd</g></source><seg-source><mrk mtype="seg" mid="595">перс. <g id="8770">şagerd</g></mrk></seg-source><target><mrk mtype="seg" mid="595">Persian şagerd</mrk></target><sdl:seg-defs><sdl:seg id="595" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">FeMkrCP/BlagilN8CFpSvSBcc6U=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">FeMkrCP/BlagilN8CFpSvSBcc6U=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">86217831</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="269"/><sdl:cxt id="38"/><sdl:cxt id="39"/><sdl:cxt id="40"/><sdl:node id="188"/></sdl:cxts><trans-unit id="3d6291d0-8535-4f68-8093-767d7f3f27f8"><source>ученик, последователь учения</source><seg-source><mrk mtype="seg" mid="596">ученик, последователь учения</mrk></seg-source><target><mrk mtype="seg" mid="596">student, follower of a teaching</mrk></target><sdl:seg-defs><sdl:seg id="596" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">Yz1PswdSeaJO6/BkryjBd8nrxxU=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Yz1PswdSeaJO6/BkryjBd8nrxxU=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-994456284</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="270"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="c8ad5595-ad60-433c-be6c-337c0c7c811f"><source>Табл. 5. Гебраизмы и их лексические соответствия в татском </source><seg-source><mrk mtype="seg" mid="597">Табл.</mrk> <mrk mtype="seg" mid="598">5.</mrk> <mrk mtype="seg" mid="599">Гебраизмы и их лексические соответствия в татском</mrk> </seg-source><target><mrk mtype="seg" mid="597">Table</mrk> <mrk mtype="seg" mid="598">5.</mrk> <mrk mtype="seg" mid="599">Hebraisms and their lexical equivalents in Tat</mrk> </target><sdl:seg-defs><sdl:seg id="597" conf="Draft" origin="interactive"><sdl:rep id="Wii3iR2j5y4NuMCHg2qG75EQdtM="/><sdl:prev-origin origin="source"><sdl:rep id="Wii3iR2j5y4NuMCHg2qG75EQdtM="/><sdl:value key="SegmentIdentityHash">Wii3iR2j5y4NuMCHg2qG75EQdtM=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Wii3iR2j5y4NuMCHg2qG75EQdtM=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">583126357</sdl:value></sdl:seg><sdl:seg id="598" conf="Draft" origin="tm" origin-system="belle lettre RU_ENuk" percent="100"><sdl:rep id="kvDb2IoakeVV5COiU7UJZ5iVYjA="/><sdl:value key="SegmentIdentityHash">kvDb2IoakeVV5COiU7UJZ5iVYjA=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-631598461</sdl:value></sdl:seg><sdl:seg id="599" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">gcnEkDxSX6koSa/GpRHiJXwBWTU=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">gcnEkDxSX6koSa/GpRHiJXwBWTU=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-223738959</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="271"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="e52b689b-fd99-4d20-a7a4-ee1ae1aa8aad"><source>К сожалению, пока не удалось найти татские соответствия многим гебраизмам: <g id="8785">paşut</g> ‘простой, наивный’ (פּשוט), <g id="8818">şovԧo</g> ‘клятва’ (שבועה), <g id="8845">xoxom</g> ‘мудрец’ (חכם), <g id="8872">şolum</g> формула приветствия и <g id="8881">şolumi</g> ‘мир’, (שלום), <g id="8908">syԧydo</g> ‘трапеза’ (סעודה), <g id="8926">məsubo</g> ‘надгробие’ (מצבה) и другим. </source><seg-source><mrk mtype="seg" mid="600">К сожалению, пока не удалось найти татские соответствия многим гебраизмам: <g id="8785">paşut</g> ‘простой, наивный’ (פּשוט), <g id="8818">şovԧo</g> ‘клятва’ (שבועה), <g id="8845">xoxom</g> ‘мудрец’ (חכם), <g id="8872">şolum</g> формула приветствия и <g id="8881">şolumi</g> ‘мир’, (שלום), <g id="8908">syԧydo</g> ‘трапеза’ (סעודה), <g id="8926">məsubo</g> ‘надгробие’ (מצבה) и другим.</mrk> </seg-source><target><mrk mtype="seg" mid="600">Unfortunately, it has not yet been possible to find Tat equivalents for many Hebraisms: paşut ‘simple, naive’ (פּשוט), şovԧo ‘oath’ (שבועה), xoxom ‘wise man’ (חכם), şolum greeting formula and şolumi ‘peace’, (שלום), syԧydo ‘meal’ (סעודה), məsubo ‘gravestone’ (מצבה), and others.</mrk> </target><sdl:seg-defs><sdl:seg id="600" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">qzmWIMI56IJSRZLfmnoB7+Liw1s=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">qzmWIMI56IJSRZLfmnoB7+Liw1s=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1485006928</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="272"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="7ed8929c-ad20-4025-93e3-3e1e11c3da5d"><source> </source><seg-source> </seg-source><target> </target></trans-unit></group><group><sdl:cxts><sdl:cxt id="273"/><sdl:cxt id="14"/><sdl:node id="189"/></sdl:cxts><trans-unit id="df11cb4f-8a93-48e4-bea8-0abe69f7887b"><source>Заключение</source><seg-source><mrk mtype="seg" mid="601">Заключение</mrk></seg-source><target><mrk mtype="seg" mid="601">Conclusion</mrk></target><sdl:seg-defs><sdl:seg id="601" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">ex8L8of9Yr67KHhU9urm5Ch9QZc=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">ex8L8of9Yr67KHhU9urm5Ch9QZc=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1410608120</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="274"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="b75dbd7d-5e21-44f2-947e-cc48108642c0"><source>Традиция изучения джуури и татского языка насчитывает более ста лет. Это относительно богатая традиция, и имеющиеся описания позволили нам проанализировать некоторые различия между татским и джуури, но описаний явно недостаточно. Семантика атрибутивных конструкций, большинство аналитических форм глагола и их видо-временные и модальные значения, словообразование, предлоги и многие другие темы остались неосвещенными. Изучить эти вопросы планируется при помощи корпусных исследований – на корпусе текстов на джуури, собранных в библиотеке фонда СТМЭГИ, и относительно небольшом корпусе текстов на татском языке, имеющихся в фондах отдела национальных литератур Российской национальной библиотеки. </source><seg-source><mrk mtype="seg" mid="602">Традиция изучения джуури и татского языка насчитывает более ста лет.</mrk> <mrk mtype="seg" mid="603">Это относительно богатая традиция, и имеющиеся описания позволили нам проанализировать некоторые различия между татским и джуури, но описаний явно недостаточно.</mrk> <mrk mtype="seg" mid="604">Семантика атрибутивных конструкций, большинство аналитических форм глагола и их видо-временные и модальные значения, словообразование, предлоги и многие другие темы остались неосвещенными.</mrk> <mrk mtype="seg" mid="605">Изучить эти вопросы планируется при помощи корпусных исследований – на корпусе текстов на джуури, собранных в библиотеке фонда СТМЭГИ, и относительно небольшом корпусе текстов на татском языке, имеющихся в фондах отдела национальных литератур Российской национальной библиотеки.</mrk> </seg-source><target><mrk mtype="seg" mid="602">The tradition of studying Juhuri and the Tat language spans more than a hundred years.</mrk> <mrk mtype="seg" mid="603">This is a relatively rich tradition, and the available descriptions have allowed us to analyze some differences between Tat and Juhuri, but the descriptions are clearly insufficient.</mrk> <mrk mtype="seg" mid="604">The semantics of attributive constructions, most analytical verb forms and their aspectual-temporal and modal meanings, word formation, prepositions, and many other topics remained unaddressed.</mrk> <mrk mtype="seg" mid="605">It is planned to study these issues through corpus-based research – using a corpus of Juhuri texts collected in the library of the STMEGI Foundation, and a relatively small corpus of Tat texts available in the collections of the Department of National Literatures of the National Library of Russia.</mrk> </target><sdl:seg-defs><sdl:seg id="602" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">v0Tq908qbasFhpZlgPcUtNTqZq4=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">v0Tq908qbasFhpZlgPcUtNTqZq4=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">517294023</sdl:value></sdl:seg><sdl:seg id="603" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">NJlqrEkDNxi26oZAb2JX+ZwfHJE=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">NJlqrEkDNxi26oZAb2JX+ZwfHJE=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-101931805</sdl:value></sdl:seg><sdl:seg id="604" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">gzg5le/b+L78K+FdPyrdzZws+Wc=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">gzg5le/b+L78K+FdPyrdzZws+Wc=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2055537811</sdl:value></sdl:seg><sdl:seg id="605" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">Dd5NeXcl8zIh1Sf3Z+7lxKirKI4=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Dd5NeXcl8zIh1Sf3Z+7lxKirKI4=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">74720441</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="275"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="6401eaca-132f-4368-af2c-cbe580028a14"><source>Еще одно привлекательное направление дальнейших исследований – это сопоставление джуури с другими еврейско-иранскими языками. Здесь особенно интересен вопрос о составе лексического пласта гебраизмов за пределами семантического поля религии и о способах адаптации гебраизмов в различных еврейско-иранских языках. </source><seg-source><mrk mtype="seg" mid="606">Еще одно привлекательное направление дальнейших исследований – это сопоставление джуури с другими еврейско-иранскими языками.</mrk> <mrk mtype="seg" mid="607">Здесь особенно интересен вопрос о составе лексического пласта гебраизмов за пределами семантического поля религии и о способах адаптации гебраизмов в различных еврейско-иранских языках.</mrk> </seg-source><target><mrk mtype="seg" mid="606">Another attractive area for further research is the comparison of Juhuri with other Judeo-Iranian languages.</mrk> <mrk mtype="seg" mid="607">Of particular interest here is the composition of the lexical layer of Hebraisms outside the semantic field of religion and the methods of adapting Hebraisms in various Judeo-Iranian languages.</mrk> </target><sdl:seg-defs><sdl:seg id="606" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">OarjFwlDk40ZTQAQsefphmMRDXA=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">OarjFwlDk40ZTQAQsefphmMRDXA=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1425891357</sdl:value></sdl:seg><sdl:seg id="607" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">XdZtB48Dd+P3oMTlQyPY03h9n8w=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">XdZtB48Dd+P3oMTlQyPY03h9n8w=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1867843809</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="276"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="7d2bee8e-c5b8-4322-a133-9477b4ceacb8"><source>В заключение я хочу еще раз подчеркнуть, что никакие структурные различия ничего не означают для решения вопроса о статусе языка. </source><seg-source><mrk mtype="seg" mid="608">В заключение я хочу еще раз подчеркнуть, что никакие структурные различия ничего не означают для решения вопроса о статусе языка.</mrk> </seg-source><target><mrk mtype="seg" mid="608">In conclusion, I want to emphasize once again that no structural differences mean anything for resolving the question of language status.</mrk> </target><sdl:seg-defs><sdl:seg id="608" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">6hVVgi+S572IT8KA005GWmkyTzI=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">6hVVgi+S572IT8KA005GWmkyTzI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1972439250</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="277"/><sdl:cxt id="14"/><sdl:node id="190"/></sdl:cxts><trans-unit id="f60220f7-17ef-43f6-a913-daf259249151"><source>Литература</source><seg-source><mrk mtype="seg" mid="609">Литература</mrk></seg-source><target><mrk mtype="seg" mid="609">References</mrk></target><sdl:seg-defs><sdl:seg id="609" conf="Draft" origin="tm" origin-system="Jew_study_RU_EnUK" percent="100"><sdl:value key="SegmentIdentityHash">mVGoOx9KIisJYvSBufsq+akvgVQ=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-933806608</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="278"/><sdl:cxt id="14"/><sdl:node id="191"/></sdl:cxts><trans-unit id="5a44eed4-5bf0-43a2-8c1c-0e618f0f7a58"><source>Словари</source><seg-source><mrk mtype="seg" mid="610">Словари</mrk></seg-source><target><mrk mtype="seg" mid="610">Dictionaries</mrk></target><sdl:seg-defs><sdl:seg id="610" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">Ro5a9gAEyJS7vWzgL+zT1NLK1vk=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Ro5a9gAEyJS7vWzgL+zT1NLK1vk=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1716828866</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="279"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="9a3fd320-a2a6-44d6-aa98-b066a76254af"><source>Агарунов Я. М., Агарунов М. Я. Татско (еврейско) – русский словарь. Lyqət əz çuhuri ə urusi. М.: Еврейский университет в Москве, 1997</source><seg-source><mrk mtype="seg" mid="611">Агарунов Я.</mrk> <mrk mtype="seg" mid="612">М., Агарунов М.</mrk> <mrk mtype="seg" mid="613">Я.</mrk> <mrk mtype="seg" mid="614">Татско (еврейско) – русский словарь.</mrk> <mrk mtype="seg" mid="615">Lyqət əz çuhuri ə urusi.</mrk> <mrk mtype="seg" mid="616">М.:</mrk> <mrk mtype="seg" mid="617">Еврейский университет в Москве, 1997</mrk></seg-source><target><mrk mtype="seg" mid="611">Agarunov Ya.</mrk> <mrk mtype="seg" mid="612">M., Agarunov M.</mrk> <mrk mtype="seg" mid="613">Ya.</mrk> <mrk mtype="seg" mid="614">Tat (Judeo) – Russian Dictionary.</mrk> <mrk mtype="seg" mid="615">Lyqət əz çuhuri ə urusi.</mrk> <mrk mtype="seg" mid="616">M.:</mrk> <mrk mtype="seg" mid="617">Jewish University in Moscow, 1997</mrk></target><sdl:seg-defs><sdl:seg id="611" conf="Draft" origin="interactive"><sdl:rep id="EOENhEK1qEit6bvaM5KGHALUTFw="/><sdl:prev-origin origin="source"><sdl:rep id="EOENhEK1qEit6bvaM5KGHALUTFw="/><sdl:value key="SegmentIdentityHash">EOENhEK1qEit6bvaM5KGHALUTFw=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">EOENhEK1qEit6bvaM5KGHALUTFw=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">876500006</sdl:value></sdl:seg><sdl:seg id="612" conf="Draft" origin="interactive"><sdl:rep id="lgPDxW5jB7lugTCoVwyAyZF18jQ="/><sdl:prev-origin origin="source"><sdl:rep id="lgPDxW5jB7lugTCoVwyAyZF18jQ="/><sdl:value key="SegmentIdentityHash">lgPDxW5jB7lugTCoVwyAyZF18jQ=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">lgPDxW5jB7lugTCoVwyAyZF18jQ=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1156933372</sdl:value></sdl:seg><sdl:seg id="613" conf="Draft" origin="interactive"><sdl:rep id="XAUxg6tVPSWBsaAU0sFUfxXD3Gk="/><sdl:prev-origin origin="source"><sdl:rep id="XAUxg6tVPSWBsaAU0sFUfxXD3Gk="/><sdl:value key="SegmentIdentityHash">XAUxg6tVPSWBsaAU0sFUfxXD3Gk=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">XAUxg6tVPSWBsaAU0sFUfxXD3Gk=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1849513147</sdl:value></sdl:seg><sdl:seg id="614" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">Bd2Wfi26uPO7eINiVfFBpHPqsn4=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Bd2Wfi26uPO7eINiVfFBpHPqsn4=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1520724831</sdl:value></sdl:seg><sdl:seg id="615" conf="Draft" origin="source"><sdl:value key="SegmentIdentityHash">O2ECEJvGMAq++Tuxhr9cu+GSrqg=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1217538422</sdl:value></sdl:seg><sdl:seg id="616" conf="Draft" origin="tm" origin-system="Jew_study_RU_EnUK" percent="100"><sdl:rep id="OH+7mInhN2DlnNx8XbkaVLdROj4="/><sdl:value key="SegmentIdentityHash">OH+7mInhN2DlnNx8XbkaVLdROj4=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:10</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:47</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">133133263</sdl:value></sdl:seg><sdl:seg id="617" conf="Draft" origin="interact