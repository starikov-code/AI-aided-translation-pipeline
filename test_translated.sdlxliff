-1506481736</sdl:value></sdl:seg><sdl:seg id="393" conf="Draft" origin="source"><sdl:value key="SegmentIdentityHash">pWuKT7h7XAcJAjGaKq2T7GcJuuk=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="SDL:OriginalTranslationHash">434984417</sdl:value></sdl:seg><sdl:seg id="394" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">T3b+FNBlo6zNG9ln8pk/Ey60aNo=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">T3b+FNBlo6zNG9ln8pk/Ey60aNo=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-720322570</sdl:value></sdl:seg><sdl:seg id="395" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">Bcr+fhGChST4EVnVG4G12vESwEM=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Bcr+fhGChST4EVnVG4G12vESwEM=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1331845466</sdl:value></sdl:seg><sdl:seg id="396" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">DeF5SSlY1tKMkukqW21E5lsPDXs=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">DeF5SSlY1tKMkukqW21E5lsPDXs=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1057366106</sdl:value></sdl:seg><sdl:seg id="397" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">701UZQ6XWjXLp/o2acECXJAM5t4=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">701UZQ6XWjXLp/o2acECXJAM5t4=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1791091192</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="142"/><sdl:cxt id="23"/><sdl:node id="80"/></sdl:cxts><trans-unit id="454d045a-9118-47db-bf70-a1e4b954b332"><source><x id="941"/> В речи младшего поколения основа I выравнивается по основе II: наряду с <g id="953">suz</g>, <g id="956">vaz</g> встречаются <g id="959">sux</g>, <g id="962">vax</g> (Грюнберг 1963: 60). </source><seg-source><mrk mtype="seg" mid="398"><x id="941"/> В речи младшего поколения основа I выравнивается по основе II: наряду с <g id="953">suz</g>, <g id="956">vaz</g> встречаются <g id="959">sux</g>, <g id="962">vax</g> (Грюнберг 1963:</mrk> <mrk mtype="seg" mid="399">60).</mrk> </seg-source><target><mrk mtype="seg" mid="398"><x id="941"/> In the speech of the younger generation, Stem I is leveled according to Stem II: alongside suz, vaz, one finds sux, vax (Grünberg 1963:</mrk> <mrk mtype="seg" mid="399">60).</mrk> </target><sdl:seg-defs><sdl:seg id="398" conf="Draft" origin="source"><sdl:value key="SegmentIdentityHash">+mW7YLFe8i9x0tIlSi0ToFe5LdM=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-606841779</sdl:value></sdl:seg><sdl:seg id="399" conf="Draft" origin="tm" origin-system="Jew_study_RU_EnUK" percent="100"><sdl:rep id="MXAHRxiF+It6HYw3JouPkebr7Fg="/><sdl:value key="SegmentIdentityHash">MXAHRxiF+It6HYw3JouPkebr7Fg=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-336094169</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="143"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="4e1f67e6-ae26-45b6-8723-0eb858917772"><source>От основы I образуются все формы косвенных наклонений: императив, конъюнктив, оптатив (только в джуури) и форма, которую называют по-разному (Грюнберг, Назарова – будущее потенциальное, Вс. Миллер и Анисимов – будущее, Отье и Сулейманов – потенциальное (éventuel, eventual)), выражающая прежде всего модальное, а не видо-временное значение (анализ этой формы Ефимов и др. 438). Форма конъюнктива восходит к аористу в классическом персидском языке, поэтому исследователи, придерживающиеся иранистической традиции, называют ее аористом (Анисимов, Грюнберг, Назарова. Богданов), но на синхронном уровне ее употребление ничего общего с обычным аористом не имеет, поэтому я буду называть ее конъюнктивом (как и Вс. Ф. Миллер и Отье). Форма оптатива в джуури восходит к конъюнктиву в классическом персидском, исконный оптатив утрачен в обоих языках (Грюнберг, Давыдова 1982: 267).  </source><seg-source><mrk mtype="seg" mid="400">От основы I образуются все формы косвенных наклонений: императив, конъюнктив, оптатив (только в джуури) и форма, которую называют по-разному (Грюнберг, Назарова – будущее потенциальное, Вс.</mrk> <mrk mtype="seg" mid="401">Миллер и Анисимов – будущее, Отье и Сулейманов – потенциальное (éventuel, eventual)), выражающая прежде всего модальное, а не видо-временное значение (анализ этой формы Ефимов и др.</mrk> <mrk mtype="seg" mid="402">438).</mrk> <mrk mtype="seg" mid="403">Форма конъюнктива восходит к аористу в классическом персидском языке, поэтому исследователи, придерживающиеся иранистической традиции, называют ее аористом (Анисимов, Грюнберг, Назарова.</mrk> <mrk mtype="seg" mid="404">Богданов), но на синхронном уровне ее употребление ничего общего с обычным аористом не имеет, поэтому я буду называть ее конъюнктивом (как и Вс.</mrk> <mrk mtype="seg" mid="405">Ф.</mrk> <mrk mtype="seg" mid="406">Миллер и Отье).</mrk> <mrk mtype="seg" mid="407">Форма оптатива в джуури восходит к конъюнктиву в классическом персидском, исконный оптатив утрачен в обоих языках (Грюнберг, Давыдова 1982:</mrk> <mrk mtype="seg" mid="408">267).</mrk>  </seg-source><target><mrk mtype="seg" mid="400">From Stem I, all forms of oblique moods are formed: the imperative, subjunctive, optative (only in Juhuri), and a form that is named differently (Grünberg, Nazarova – future potential, Vs.</mrk> <mrk mtype="seg" mid="401">Miller and Anisimov – future, Authier and Suleymanov – potential (éventuel, eventual)), expressing primarily a modal rather than aspectual-temporal meaning (analysis of this form: Efimov et al.</mrk> <mrk mtype="seg" mid="402">438).</mrk> <mrk mtype="seg" mid="403">The subjunctive form goes back to the aorist in Classical Persian, so researchers adhering to the Iranian tradition call it the aorist (Anisimov, Grünberg, Nazarova.</mrk> <mrk mtype="seg" mid="404">Bogdanov), but at the synchronic level its usage has nothing in common with the regular aorist, so I will call it the subjunctive (as do Vs.</mrk> <mrk mtype="seg" mid="405">F.</mrk> <mrk mtype="seg" mid="406">Miller and Authier).</mrk> <mrk mtype="seg" mid="407">The optative form in Juhuri goes back to the subjunctive in Classical Persian; the original optative is lost in both languages (Grünberg, Davydova 1982:</mrk> <mrk mtype="seg" mid="408">267).</mrk>  </target><sdl:seg-defs><sdl:seg id="400" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">az8BIzicpwlRR3UtZSTQJWpZn9E=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">az8BIzicpwlRR3UtZSTQJWpZn9E=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1800229563</sdl:value></sdl:seg><sdl:seg id="401" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">0Grgh7a9l8EBOkWoKXeIkZU4efI=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">0Grgh7a9l8EBOkWoKXeIkZU4efI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1484707066</sdl:value></sdl:seg><sdl:seg id="402" conf="Draft" origin="tm" origin-system="Jew_study_RU_EnUK" percent="100"><sdl:rep id="MXAHRxiF+It6HYw3JouPkebr7Fg="/><sdl:value key="SegmentIdentityHash">MXAHRxiF+It6HYw3JouPkebr7Fg=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1159301170</sdl:value></sdl:seg><sdl:seg id="403" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">