y="SegmentIdentityHash">5Lgc1RjqBkfVT/MIvgVMfuHH45M=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">5Lgc1RjqBkfVT/MIvgVMfuHH45M=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1060873608</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="157"/><sdl:cxt id="38"/><sdl:cxt id="39"/><sdl:cxt id="40"/><sdl:node id="93"/></sdl:cxts><trans-unit id="780b1847-61b9-4682-98db-47967c1787f0"><source><g id="6237">mirasu</g>    дж. <g id="6258">mirasut</g>, тат. <g id="6279">mirasund</g></source><seg-source><mrk mtype="seg" mid="423"><g id="6237">mirasu</g>    дж. <g id="6258">mirasut</g>, тат. <g id="6279">mirasund</g></mrk></seg-source><target><mrk mtype="seg" mid="423">mirasu    Juh. mirasut, Tat mirasund</mrk></target><sdl:seg-defs><sdl:seg id="423" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">TjoaiTFMdbs9Ey6bJ18id5Tgyis=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">TjoaiTFMdbs9Ey6bJ18id5Tgyis=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-833301384</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="158"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="56af8687-5d55-4bb0-b3e8-53a9b2aa7a17"><source>Табл. 3. Формы, образуемые от основы I, на примере глагола ‘достигать’ (дж. и тат. основа I <g id="6321">ras</g>, основа II <g id="6333">rasir</g>)</source><seg-source><mrk mtype="seg" mid="424">Табл.</mrk> <mrk mtype="seg" mid="425">3.</mrk> <mrk mtype="seg" mid="426">Формы, образуемые от основы I, на примере глагола ‘достигать’ (дж. и тат. основа I <g id="6321">ras</g>, основа II <g id="6333">rasir</g>)</mrk></seg-source><target><mrk mtype="seg" mid="424">Table</mrk> <mrk mtype="seg" mid="425">3.</mrk> <mrk mtype="seg" mid="426">Forms derived from stem I, using the verb ‘to reach’ as an example (Juh. and Tat stem I ras, stem II rasir)</mrk></target><sdl:seg-defs><sdl:seg id="424" conf="Draft" origin="interactive"><sdl:rep id="Wii3iR2j5y4NuMCHg2qG75EQdtM="/><sdl:prev-origin origin="source"><sdl:rep id="Wii3iR2j5y4NuMCHg2qG75EQdtM="/><sdl:value key="SegmentIdentityHash">Wii3iR2j5y4NuMCHg2qG75EQdtM=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Wii3iR2j5y4NuMCHg2qG75EQdtM=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">583126357</sdl:value></sdl:seg><sdl:seg id="425" conf="Draft" origin="tm" origin-system="belle lettre RU_ENuk" percent="100"><sdl:rep id="kvDb2IoakeVV5COiU7UJZ5iVYjA="/><sdl:value key="SegmentIdentityHash">kvDb2IoakeVV5COiU7UJZ5iVYjA=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-631598461</sdl:value></sdl:seg><sdl:seg id="426" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">7gzBEONUq15aOreqxsXzLtyUgOo=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">7gzBEONUq15aOreqxsXzLtyUgOo=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1943556440</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="159"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="ae622010-de0c-4a66-9e46-8e2e02f993de"><source>От основы II образуются две синтетических формы: перфект II (результатив в прошедшем) и форма прошедшего времени, имеющая аспектуальное значение в татском (Грюнберг называет ее «прошедшее многократное») и модальное значение в джуури (Вс. Миллер называет ее Conditionalis, Отье éventuel passé). В 3Sg глаголов на -<g id="6399">rə</g> согласный -<g id="6405">r </g>выпадает, форма оканчивается на последний гласный основы (дж. <g id="6420">omorə – omo</g> ‘приходить’, <g id="6444">dirə – di</g> ‘видеть’). </source><seg-source><mrk mtype="seg" mid="427">От основы II образуются две синтетических формы: перфект II (результатив в прошедшем) и форма прошедшего времени, имеющая аспектуальное значение в татском (Грюнберг называет ее «прошедшее многократное») и модальное значение в джуури (Вс.</mrk> <mrk mtype="seg" mid="428">Миллер называет ее Conditionalis, Отье éventuel passé).</mrk> <mrk mtype="seg" mid="429">В 3Sg глаголов на -<g id="6399">rə</g> согласный -<g id="6405">r </g>выпадает, форма оканчивается на последний гласный основы (дж. <g id="6420">omorə – omo</g> ‘приходить’, <g id="6444">dirə – di</g> ‘видеть’).</mrk> </seg-source><target><mrk mtype="seg" mid="427">From Stem II, two synthetic forms are formed: Perfect II (resultative past) and a past tense form that has an aspectual meaning in Tat (Grünberg calls it &quot;past iterative&quot;) and a modal meaning in Juhuri (Vs.</mrk> <mrk mtype="seg" mid="428">Miller calls it Conditionalis, Authier éventuel passé).</mrk> <mrk mtype="seg" mid="429">In the 3Sg of verbs in -rə, the consonant -r falls out, and the form ends in the last vowel of the stem (Juh. omorə – omo ‘to come’, dirə – di ‘to see’).</mrk> </target><sdl:seg-defs><sdl:seg id="427" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">4k8bLT9NbOt19Ct19YztbySdxeA=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">4k8bLT9NbOt19Ct19YztbySdxeA=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">586001275</sdl:value></sdl:seg><sdl:seg id="428" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">/N+FB7PP1NptCLmSQtn5CS9Vg+E=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">/N+FB7PP1NptCLmSQtn5CS9Vg+E=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-114983020</sdl:value></sdl:seg><sdl:seg id="429" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">MwSWXoXHAuUukPW5lm8LbjuhUC4=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">MwSWXoXHAuUukPW5lm8LbjuhUC4=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">422058300</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="160"/><sdl:cxt id="38"/><sdl:cxt id="39"/><sdl:cxt id="40"/><sdl:node id="96"/></sdl:cxts><trans-unit id="59ba7a4f-6fa6-4714-99d4-51f1e77d238e"><source>Перфект II</source><seg-source><mrk mtype="seg" mid="430">Перфект II</mrk></seg-source><target><mrk mtype="seg" mid="430">Perfect II</mrk></target><sdl:seg-defs><sdl:seg id="430" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">QtLw5I9ljGmWCLff+1enoc74OzI=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">QtLw5I9ljGmWCLff+1enoc74OzI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">348845959</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="161"/><sdl:cxt id="38"/><sdl:cxt id="39"/><sdl:cxt id="40"/><sdl:node id="97"/></sdl:cxts><trans-unit id="12023143-5f44-4f40-a893-3e330f8721b1"><source>тат. Прошедшее многократное, дж. Форма прошедшего времени, выражающая ирреальные значения </source><seg-source><mrk mtype="seg" mid="431">тат.</mrk> <mrk mtype="seg" mid="432">Прошедшее многократное, дж.</mrk> <mrk mtype="seg" mid="433">Форма прошедшего времени, выражающая ирреальные значения</mrk> </seg-source><target><mrk mtype="seg" mid="431">Tat.</mrk> <mrk mtype="seg" mid="432">Past iterative, Juh.</mrk> <mrk mtype="seg" mid="433">Past tense form expressing irrealis meanings</mrk> </target><sdl:seg-defs><sdl:seg id="431" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">00WH5vYmtnSD87njuZw5HqnT3zI=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">00WH5vYmtnSD87njuZw5HqnT3zI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:46</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key