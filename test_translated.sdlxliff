а и личные окончания</mrk></seg-source><target><mrk mtype="seg" mid="374">Table</mrk> <mrk mtype="seg" mid="375">2.</mrk> <mrk mtype="seg" mid="376">Infinitive marker and personal endings</mrk></target><sdl:seg-defs><sdl:seg id="374" conf="Draft" origin="interactive"><sdl:rep id="Wii3iR2j5y4NuMCHg2qG75EQdtM="/><sdl:prev-origin origin="source"><sdl:rep id="Wii3iR2j5y4NuMCHg2qG75EQdtM="/><sdl:value key="SegmentIdentityHash">Wii3iR2j5y4NuMCHg2qG75EQdtM=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Wii3iR2j5y4NuMCHg2qG75EQdtM=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">583126357</sdl:value></sdl:seg><sdl:seg id="375" conf="Draft" origin="tm" origin-system="belle lettre RU_ENuk" percent="100"><sdl:rep id="kvDb2IoakeVV5COiU7UJZ5iVYjA="/><sdl:value key="SegmentIdentityHash">kvDb2IoakeVV5COiU7UJZ5iVYjA=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-631598461</sdl:value></sdl:seg><sdl:seg id="376" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">EU7hBpfP7QpzXf9O35XWlFxJ5CI=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">EU7hBpfP7QpzXf9O35XWlFxJ5CI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">385314954</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="139"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="297e45bc-a6a6-4ed8-a9d1-b0c00c165f82"><source>Инфинитив образуется с показателем <g id="5212">-də</g> от производящих основ на согласные и с показателем <g id="5221">-rə</g> от производящих основ на гласные, т.к. <g id="5230">-d-</g> перешло в <g id="5242">-r- </g>в интервокальной позиции. В татском инфинитив заканчивается на <g id="5257">-n</g>: <g id="5266">nyşdən</g>, <g id="5272">tərsirən</g>, в джуури <g id="5278">-n</g> утрачено<x id="5291"/> и восстанавливается только в некоторых бывших аналитических формах. </source><seg-source><mrk mtype="seg" mid="377">Инфинитив образуется с показателем <g id="5212">-də</g> от производящих основ на согласные и с показателем <g id="5221">-rə</g> от производящих основ на гласные, т.к. <g id="5230">-d-</g> перешло в <g id="5242">-r- </g>в интервокальной позиции.</mrk> <mrk mtype="seg" mid="378">В татском инфинитив заканчивается на <g id="5257">-n</g>:</mrk> <mrk mtype="seg" mid="379"><g id="5266">nyşdən</g>, <g id="5272">tərsirən</g>, в джуури <g id="5278">-n</g> утрачено<x id="5291"/> и восстанавливается только в некоторых бывших аналитических формах.</mrk> </seg-source><target><mrk mtype="seg" mid="377">The infinitive is formed with the marker -də from stems ending in consonants and with the marker -rə from stems ending in vowels, as -d- shifted to -r- in intervocalic position.</mrk> <mrk mtype="seg" mid="378">In Tat, the infinitive ends in -n:</mrk> <mrk mtype="seg" mid="379">nyşdən, tərsirən, in Juhuri -n has been lost<x id="5291"/> and is restored only in some former analytical forms.</mrk> </target><sdl:seg-defs><sdl:seg id="377" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">nJwNp25M0WE1DWJD2ajWXzx69ls=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">nJwNp25M0WE1DWJD2ajWXzx69ls=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-150075496</sdl:value></sdl:seg><sdl:seg id="378" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">f7JUvVEH6Bgg6AR7jd/dFsUwELY=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">f7JUvVEH6Bgg6AR7jd/dFsUwELY=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">860489292</sdl:value></sdl:seg><sdl:seg id="379" conf="Draft" origin="source"><sdl:value key="SegmentIdentityHash">uvUmau7p+7hTvop9ZcZNwlB+Jdg=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-903892965</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="140"/><sdl:cxt id="23"/><sdl:node id="79"/></sdl:cxts><trans-unit id="725efc76-570e-4dc0-8d29-f6856badd10b"><source><x id="931"/> В джалганском татском это -<g id="934">n</g> также утрачено (Беляев 2025: 16-17 сн.)</source><seg-source><mrk mtype="seg" mid="380"><x id="931"/> В джалганском татском это -<g id="934">n</g> также утрачено (Беляев 2025:</mrk> <mrk mtype="seg" mid="381">16-17 сн.)</mrk></seg-source><target><mrk mtype="seg" mid="380"><x id="931"/> In Jalgan Tat, this -n has also been lost (Belyaev 2025:</mrk> <mrk mtype="seg" mid="381">16-17 fn.)</mrk></target><sdl:seg-defs><sdl:seg id="380" conf="Draft" origin="source"><sdl:value key="SegmentIdentityHash">keXf/LY6TYuXvmrOj6CoGuBMsm4=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1400960315</sdl:value></sdl:seg><sdl:seg id="381" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">dZprq5eGY8Gdkj91sJCTj6pTCQU=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">dZprq5eGY8Gdkj91sJCTj6pTCQU=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1187780751</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="141"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="8c309378-9b5a-4ceb-8bb5-f70282a6181e"><source>Противопоставление двух основ сильно трансформировалось по сравнению с предыдущими стадиями развития иранских языков. Поскольку многие глагольные формы джуури и татского языка восходят к аналитическим формам, включавшим инфитинитив или совпавшее с ним причастие, в синхронии противопоставлены друг другу основа II, включающая показатель инфинитива (дж. и тат. <g id="5351">nyşdə</g> – <g id="5363">nyşd</g>, <g id="5369">tərsirə </g>– <g id="5384">tərsir</g>), и основа I, лишенная показателя инфинитива (<g id="5411">nyşdə</g> – <g id="5420">nyş</g>, <g id="5429">tərsirə</g> – <g id="5441">tərs</g>). На стыке производящей основы с показателем инфинитива могли происходить различные фонетические процессы, затемняющие исходный вид основы, поэтому основа I бывает связана с основой II историческими чередованиями: дж. <g id="5483">giro<g id="5486">ş</g>də – giro<g id="5498">r</g></g>, тат. <g id="5507">gyra<g id="5510">ş</g>də – gyra<g id="5522">r</g></g> ‘проходить’, дж. <g id="5537">vəc<g id="5540">ir</g>ə – vəc<g id="5555">yn</g></g>, тат. <g id="5561">vəci<g id="5564">r</g>ə – vəci<g id="5582">n</g></g> ‘собирать’. По соотношению двух основ выделяют несколько классов глаголов (Миллер 1901: 19-26, 1907: 44-49, Грюнберг 1963: 53-58, Грюнберг, Давыдова 1982: 262-265). Распределение глаголов по этим классам не всегда совпадает в джуури и татском: тат. <g id="5624">suxdə – suz</g>, дж. <g id="5642">suxdə – sux</g> ‘гореть’, тат. <g id="5672">vaxdə – vaz<x id="5682"/></g>, дж. <g id="5691">vozirə – voz</g> ‘играть’, тат. <g id="5712">gyfdə – gir</g>, дж. <g id="5727">gyrdə – gir</g> ‘держать’. В основном эти несовпадения объясняются фонетическими процессами, встречается также развитие супплетивизма в татском при сохранении двух разных глаголов в джуури: тат. <g id="5775">narə – il/bil</g> ‘класть’ (Грюнберг, Давыдова 1982: 264), дж. <g id="5820">norə – n</g> ‘класть’, <g id="5841">hişdə – hil/bihil</g> ‘пускать, позволять’.</source><seg-source><mrk mtype="seg" mid="382">Противопоставление двух основ сильно трансформировалось по сравнению с предыдущими стадиями развития иранских языков.</mrk> <mrk mtype="seg" mid="383">Поскольку многие глагольные формы джуури и татского языка восходят к аналитическим формам, включавшим инфитинитив или совпавшее с ним причастие, в синхронии противопоставлены друг другу основа II, включающая показатель инфинитива (дж. и тат.</mrk> <mrk mtype="seg" mid="384"><g id="5351">nyşdə</g> – <g id="5363">nyşd</g>, <g id="5369">tərsirə </g>– <g id="5384">tərsir</g>), и основа I, лишенная показателя инфинитива (<g id="5411">nyşdə</g> – <g id="5420">nyş</g>, <g id="5429">tərsirə</g> – <g id="5441">tərs</g>).</mrk> <mrk mtype="seg" mid="385">На стыке производящей основы с показателем инфинитива могли происходить различные фонетические процессы, затемняющие исходный вид основы, поэтому основа I бывает связана с основой II историческими чередованиями: дж.</mrk> <mrk mtype="seg" mid="386"><g id="5483">giro<g id="5486">ş</g>də – giro<g id="5498">r</g></g>, тат. <g id="5507">gyra<g id="5510">ş</g>də – gyra<g id="5522">r</g></g> ‘проходить’, дж. <g id="5537">vəc<g id="5540">ir</g>ə – vəc<g id="5555">yn</g></g>, тат. <g id="5561">vəci<g id="5564">r</g>ə – vəci<g id="5582">n</g></g> ‘собирать’.</mrk> <mrk mtype="seg" mid="387">По соотношению двух основ выделяют несколько классов глаголов (Миллер 1901:</mrk> <mrk mtype="seg" mid="388">19-26, 1907:</mrk> <mrk mtype="seg" mid="389">44-49, Грюнберг 1963:</mrk> <mrk mtype="seg" mid="390">53-58, Грюнберг, Давыдова 1982:</mrk> <mrk mtype="seg" mid="391">262-265).</mrk> <mrk mtype="seg" mid="392">Распределение глаголов по этим классам не всегда совпадает в джуури и татском: тат.</mrk> <mrk mtype="seg" mid="393"><g id="5624">suxdə – suz</g>, дж. <g id="5642">suxdə – sux</g> ‘гореть’, тат. <g id="5672">vaxdə – vaz<x id="5682"/></g>, дж. <g id="5691">vozirə – voz</g> ‘играть’, тат. <g id="5712">gyfdə – gir</g>, дж. <g id="5727">gyrdə – gir</g> ‘держать’.</mrk> <mrk mtype="seg" mid="394">В основном эти несовпадения объясняются фонетическими процессами, встречается также развитие супплетивизма в татском при сохранении двух разных глаголов в джуури: тат.</mrk> <mrk mtype="seg" mid="395"><g id="5775">narə – il/bil</g> ‘класть’ (Грюнберг, Давыдова 1982:</mrk> <mrk mtype="seg" mid="396">264), дж.</mrk> <mrk mtype="seg" mid="397"><g id="5820">norə – n</g> ‘класть’, <g id="5841">hişdə – hil/bihil</g> ‘пускать, позволять’.</mrk></seg-source><target><mrk mtype="seg" mid="382">The opposition of the two stems has transformed significantly compared to the previous stages of development of the Iranian languages.</mrk> <mrk mtype="seg" mid="383">Since many verb forms of Juhuri and Tat derive from analytical forms that included an infinitive or a participle coinciding with it, in synchrony Stem II, which includes the infinitive marker (Juh. and Tat.</mrk> <mrk mtype="seg" mid="384">nyşdə – nyşd, tərsirə – tərsir), and Stem I, lacking the infinitive marker (nyşdə – nyş, tərsirə – tərs), are opposed to each other.</mrk> <mrk mtype="seg" mid="385">Various phonetic processes could occur at the junction of the derivational stem with the infinitive marker, obscuring the original form of the stem; therefore, Stem I can be linked to Stem II by historical alternations: Juh.</mrk> <mrk mtype="seg" mid="386">giroşdə – giror, Tat. gyraşdə – gyrar ‘to pass’, Juh. vəcirə – vəcyn, Tat. vəcirə – vəcin ‘to gather’.</mrk> <mrk mtype="seg" mid="387">Based on the relationship between the two stems, several classes of verbs are identified (Miller 1901:</mrk> <mrk mtype="seg" mid="388">19-26, 1907:</mrk> <mrk mtype="seg" mid="389">44-49, Grünberg 1963:</mrk> <mrk mtype="seg" mid="390">53-58, Grünberg, Davydova 1982:</mrk> <mrk mtype="seg" mid="391">262-265).</mrk> <mrk mtype="seg" mid="392">The distribution of verbs across these classes does not always coincide in Juhuri and Tat: Tat.</mrk> <mrk mtype="seg" mid="393">suxdə – suz, Juh. suxdə – sux ‘to burn’, Tat. vaxdə – vaz<x id="5682"/>, Juh. vozirə – voz ‘to play’, Tat. gyfdə – gir, Juh. gyrdə – gir ‘to hold’.</mrk> <mrk mtype="seg" mid="394">Mostly, these discrepancies are explained by phonetic processes; there is also the development of suppletion in Tat while retaining two different verbs in Juhuri: Tat.</mrk> <mrk mtype="seg" mid="395">narə – il/bil ‘to put’ (Grünberg, Davydova 1982:</mrk> <mrk mtype="seg" mid="396">264), Juh.</mrk> <mrk mtype="seg" mid="397">norə – n ‘to put’, hişdə – hil/bihil ‘to let, allow’.</mrk></target><sdl:seg-defs><sdl:seg id="382" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">/ZCVAjVgfGQh/t6rQ87sHtxHuWc=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">/ZCVAjVgfGQh/t6rQ87sHtxHuWc=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2097493099</sdl:value></sdl:seg><sdl:seg id="383" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">0g1evNLyl3AeJ0Z+TCPI9eQQA/k=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">0g1evNLyl3AeJ0Z+TCPI9eQQA/k=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1342040592</sdl:value></sdl:seg><sdl:seg id="384" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">/wD4TeluauEskqBLsMYbhOR10UI=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">/wD4TeluauEskqBLsMYbhOR10UI=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1518081640</sdl:value></sdl:seg><sdl:seg id="385" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">82RUKPZks5Brw7hNrFrGFVm4c+E=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">82RUKPZks5Brw7hNrFrGFVm4c+E=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1319707581</sdl:value></sdl:seg><sdl:seg id="386" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">1VFrXB1khzm0SN2xUvUbWkVJeZs=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">1VFrXB1khzm0SN2xUvUbWkVJeZs=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1270032200</sdl:value></sdl:seg><sdl:seg id="387" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">0nltb5EADOyC5snSXU7mh4gBYV4=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">0nltb5EADOyC5snSXU7mh4gBYV4=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">347575197</sdl:value></sdl:seg><sdl:seg id="388" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">y/RYmR9cwXL7tHS1b6xPYA3K2Gs=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">y/RYmR9cwXL7tHS1b6xPYA3K2Gs=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:45</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:08</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-970624402</sdl:value></sdl:seg><sdl:seg id="389" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">Lnk4ahePSRuVPlNIEDa5z7Gn1Rk=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Lnk4ahePSRuVPlNIEDa5z7Gn1Rk=</sdl:val