key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:44</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:06</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1159264898</sdl:value></sdl:seg><sdl:seg id="252" conf="Draft" origin="source"><sdl:rep id="J7qCluJI2b6FdnrxOGOwjVmvFD8="/><sdl:value key="SegmentIdentityHash">J7qCluJI2b6FdnrxOGOwjVmvFD8=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:06</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:44</sdl:value><sdl:value key="SDL:OriginalTranslationHash">824218037</sdl:value></sdl:seg><sdl:seg id="253" conf="Draft" origin="tm" origin-system="ЛюбаяTM: Biblio_RU_EnUS" percent="98"><sdl:rep id="UB1hfmR7dczxeP5E1Cb3nqD7VMI="/><sdl:value key="SegmentIdentityHash">UB1hfmR7dczxeP5E1Cb3nqD7VMI=</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:06</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:44</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1856316471</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="77"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="5708aa59-ea03-47b0-902c-43ffee9de9f0"><source><g id="3597">Аффиксы <g id="3603">-i</g> и -<g id="3612">j</g></g> используются в атрибутивных конструкциях. Семантика атрибутивных конструкций в джуури подробно описана Е. М. Назаровой (Назарова 2002: 186 и след.), а с формальной точки зрения встречающиеся в татском и джуури атрибутивные конструкции можно разделить на несколько типов (табл. 1)</source><seg-source><mrk mtype="seg" mid="254"><g id="3597">Аффиксы <g id="3603">-i</g> и -<g id="3612">j</g></g> используются в атрибутивных конструкциях.</mrk> <mrk mtype="seg" mid="255">Семантика атрибутивных конструкций в джуури подробно описана Е.</mrk> <mrk mtype="seg" mid="256">М.</mrk> <mrk mtype="seg" mid="257">Назаровой (Назарова 2002:</mrk> <mrk mtype="seg" mid="258">186 и след.), а с формальной точки зрения встречающиеся в татском и джуури атрибутивные конструкции можно разделить на несколько типов (табл.</mrk> <mrk mtype="seg" mid="259">1)</mrk></seg-source><target><mrk mtype="seg" mid="254">The affixes -i and -j are used in attributive constructions.</mrk> <mrk mtype="seg" mid="255">The semantics of attributive constructions in Juhuri is described in detail by E.</mrk> <mrk mtype="seg" mid="256">M.</mrk> <mrk mtype="seg" mid="257">Nazarova (Nazarova 2002:</mrk> <mrk mtype="seg" mid="258">186 ff.), and from a formal point of view, the attributive constructions occurring in Tat and Juhuri can be divided into several types (Table</mrk> <mrk mtype="seg" mid="259">1)</mrk></target><sdl:seg-defs><sdl:seg id="254" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">PqUeiad7y0+iyl6Ufr0DcrrrHww=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">PqUeiad7y0+iyl6Ufr0DcrrrHww=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:44</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="created_on">09/06/2026 21:42:06</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1394003540</sdl:value></sdl:seg><sdl:seg id="255" conf="Draft" origin="interactive"><sdl:prev-origin origin="source"><sdl:value key="SegmentIdentityHash">wDVgQTyLajnwc6SKSy0MREoqa8s=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">wDVgQTyLajnwc6SKSy0MREoqa8s=</sdl:value><sdl:value key="last_modified_by">LAPTOP-VFEQ783K\stari</sdl:value><sdl:value key="modified_on">09/06/2026 21:48:44</sdl:value><sdl:value key="created_by">LAPTOP-VFEQ783K\stari</sdl:valu